import { useEffect, useState } from 'react'
import Link from 'next/link'
import { useRouter } from 'next/navigation'
import {
  Plus,
  Images,
  Trash2,
  Download,
  FolderOpen,
  Loader2,
} from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { useToast } from '@/components/ui/toast'
import { formatDate } from '@/lib/utils'

interface Project {
  id: string
  title: string
  description: string | null
  createdAt: string
  updatedAt: string
  images: { id: string; url: string; filename: string }[]
  _count: { images: number }
}

export default function DashboardPage() {
  const [projects, setProjects] = useState<Project[]>([])
  const [loading, setLoading] = useState(true)
  const [deletingId, setDeletingId] = useState<string | null>(null)
  const [generatingId, setGeneratingId] = useState<string | null>(null)
  const { toast } = useToast()
  const router = useRouter()

  useEffect(() => {
    fetchProjects()
  }, [])

  async function fetchProjects() {
    try {
      const res = await fetch('/api/projects')
      if (res.ok) {
        const data = await res.json()
        setProjects(data)
      }
    } catch {
      toast('Failed to load projects', 'error')
    } finally {
      setLoading(false)
    }
  }

  async function handleDelete(id: string) {
    if (!confirm('Delete this project and all its images?')) return
    setDeletingId(id)
    setProjects((prev) => prev.filter((p) => p.id !== id))
    try {
      const res = await fetch(`/api/projects/${id}`, { method: 'DELETE' })
      if (!res.ok) throw new Error()
      toast('Project deleted')
    } catch {
      toast('Failed to delete', 'error')
      fetchProjects()
    } finally {
      setDeletingId(null)
    }
  }

  async function handleGenerate(id: string, title: string) {
    setGeneratingId(id)
    try {
      const res = await fetch(`/api/projects/${id}/generate`, { method: 'POST' })
      if (!res.ok) {
        const err = await res.json()
        throw new Error(err.error || 'Generation failed')
      }
      const blob = await res.blob()
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = `${title.replace(/\s+/g, '-')}.pptx`
      a.click()
      URL.revokeObjectURL(url)
      toast('Presentation downloaded!')
    } catch (e: any) {
      toast(e.message || 'Failed to generate PPT', 'error')
    } finally {
      setGeneratingId(null)
    }
  }

  if (loading) {
    return (
      <div className="space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <div className="h-8 w-48 bg-slate-200 rounded animate-pulse" />
            <div className="h-4 w-64 bg-slate-100 rounded mt-2 animate-pulse" />
          </div>
        </div>
        <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[1, 2, 3].map((i) => (
            <div key={i} className="h-64 rounded-xl bg-slate-100 animate-pulse" />
          ))}
        </div>
      </div>
    )
  }

  return (
    <div className="space-y-8">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">Your Projects</h1>
          <p className="text-slate-500 mt-1">
            Convert image collections into PowerPoint presentations
          </p>
        </div>
        <Link href="/projects/new">
          <Button>
            <Plus size={18} className="mr-2" />
            New Project
          </Button>
        </Link>
      </div>

      {projects.length === 0 ? (
        <Card className="border-dashed">
          <CardContent className="flex flex-col items-center justify-center py-16 text-center">
            <div className="w-16 h-16 rounded-full bg-indigo-50 flex items-center justify-center mb-4">
              <Images className="text-indigo-500" size={28} />
            </div>
            <h3 className="text-lg font-semibold text-slate-900">No projects yet</h3>
            <p className="text-slate-500 mt-1 max-w-sm">
              Create your first project, upload images, and generate a PowerPoint in seconds.
            </p>
            <Link href="/projects/new" className="mt-6">
              <Button>
                <Plus size={18} className="mr-2" />
                Create Project
              </Button>
            </Link>
          </CardContent>
        </Card>
      ) : (
        <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <Card key={project.id} className="overflow-hidden group hover:shadow-md transition-shadow">
              <div className="h-36 bg-slate-100 relative overflow-hidden">
                {project.images.length > 0 ? (
                  <div className="grid grid-cols-2 h-full">
                    {project.images.slice(0, 4).map((img) => (
                      <div
                        key={img.id}
                        className="relative bg-cover bg-center"
                        style={{
                          backgroundImage: `url(${img.url})`,
                          gridColumn: project.images.length === 1 ? 'span 2' : undefined,
                          gridRow: project.images.length === 1 ? 'span 2' : undefined,
                        }}
                      />
                    ))}
                  </div>
                ) : (
                  <div className="flex items-center justify-center h-full text-slate-300">
                    <Images size={40} />
                  </div>
                )}
                <div className="absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded-full">
                  {project._count.images} image{project._count.images !== 1 ? 's' : ''}
                </div>
              </div>

              <CardHeader className="pb-2">
                <CardTitle className="text-base line-clamp-1">{project.title}</CardTitle>
                <CardDescription className="line-clamp-2">
                  {project.description || 'No description'}
                </CardDescription>
              </CardHeader>

              <CardContent className="pt-0">
                <p className="text-xs text-slate-400 mb-4">
                  Updated {formatDate(project.updatedAt)}
                </p>
                <div className="flex gap-2">
                  <Button
                    size="sm"
                    className="flex-1"
                    onClick={() => router.push(`/projects/${project.id}`)}
                  >
                    <FolderOpen size={14} className="mr-1.5" />
                    Open
                  </Button>
                  <Button
                    size="sm"
                    variant="outline"
                    disabled={project._count.images === 0 || generatingId === project.id}
                    onClick={() => handleGenerate(project.id, project.title)}
                  >
                    {generatingId === project.id ? (
                      <Loader2 size={14} className="animate-spin" />
                    ) : (
                      <Download size={14} />
                    )}
                  </Button>
                  <Button
                    size="sm"
                    variant="ghost"
                    className="text-red-500 hover:text-red-600 hover:bg-red-50"
                    disabled={deletingId === project.id}
                    onClick={() => handleDelete(project.id)}
                  >
                    {deletingId === project.id ? (
                      <Loader2 size={14} className="animate-spin" />
                    ) : (
                      <Trash2 size={14} />
                    )}
                  </Button>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      )}
    </div>
  )
}

